{
  "name": "dsh-screenshot",
  "version": "2.1.5",
  "description": "Built-in screenshot tool v2 for DeepSeek Harness on Windows: native overlay, window/screen/taskbar auto-detection, annotation, mosaic; the result lands in the composer.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "screenshot",
    "snipping-tool",
    "windows",
    "annotation"
  ],
  "files": [
    "bin/",
    "lib/",
    "src/",
    "cordis.patch.yml",
    "docs/",
    "!docs/screenshots/",
    "README.md",
    "README.en.md"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
